# HTML: nunca cachear, sempre buscar versão mais nova
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

# Imagens e ícones: pode cachear por mais tempo (raramente mudam de nome)
/assets/*
  Cache-Control: public, max-age=604800
